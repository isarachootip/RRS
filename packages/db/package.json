{
  "name": "@rrs/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@rrs/shared": "workspace:*"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.0.2",
    "@types/node": "22.18.0",
    "dotenv": "16.4.7",
    "prisma": "6.16.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "testing.js",
    "testing.d.ts"
  ]
}
