{
  "name": "rrs",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @rrs/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rrs/db generate",
    "db:migrate": "pnpm --filter @rrs/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @rrs/db migrate:dev",
    "db:seed": "pnpm --filter @rrs/db seed",
    "import:owners": "pnpm --filter @rrs/db import:owners",
    "import:assets": "pnpm --filter @rrs/db import:assets",
    "import:leads": "pnpm --filter @rrs/db import:leads"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  }
}
