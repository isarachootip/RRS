# คัดลอกเป็น .env แล้วแก้ค่าตามเครื่อง
DATABASE_URL="postgresql://rrs:rrs@localhost:5433/rrs?schema=public"
# ฐานข้อมูลสำหรับเทสต์ (ถูกล้างทุกครั้งที่รันเทสต์)
TEST_DATABASE_URL="postgresql://rrs:rrs@localhost:5433/rrs_test?schema=public"
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="rrs-files"

# API
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
PORTAL_ORIGIN="http://localhost:3001"
LOG_LEVEL="info"
SWAGGER_ENABLED="true"
# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# การยืนยันตัวตน — production ต้องสร้างค่าใหม่: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-change-me-0123456789-abcdefghijklmnop"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE="false"
# สร้างใหม่: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY="ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMtbG9uZyE="
TOTP_ISSUER="RRS"
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
# อีเมล: log = แสดงใน console ของ API (ตอนพัฒนา), smtp = ส่งจริง
MAIL_TRANSPORT="log"
SMTP_URL=""
MAIL_FROM="RRS <no-reply@example.com>"
